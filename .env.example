# Copy this file to .env and adjust the values for your environment.
# The application reads these variables from the process environment (getenv).

# ---------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------

# Database driver: pdo_sqlite, pdo_mysql or pdo_pgsql
APP_DB_DRIVER=pdo_sqlite

# Charset used by the database connection
APP_DB_CHARSET=utf8

# --- SQLite (used when APP_DB_DRIVER=pdo_sqlite) ---

# Path to the SQLite database file
APP_DB_PATH=var/data.db

# --- MySQL / PostgreSQL (used when APP_DB_DRIVER=pdo_mysql or pdo_pgsql) ---

# Database host
APP_DB_HOST=127.0.0.1

# Database port (MySQL: 3306, PostgreSQL: 5432)
APP_DB_PORT=3306

# Database name
APP_DB_NAME=slim_app

# Database user
APP_DB_USER=slim_app

# Database password
APP_DB_PASSWORD=
