# Copy this file to .env and adjust the values for your environment.
# The application reads these variables from the process environment (getenv).
#
# When running with docker compose, this file is read automatically and the
# variables are injected into the containers. The default docker compose setup
# uses SQLite and needs no database service:
#
#   docker compose up -d
#
# To use PostgreSQL or MySQL, follow the commented examples in
# docker-compose.yml and set the matching values here (e.g.
# APP_DB_DRIVER=pdo_pgsql and APP_DB_HOST=postgres).

# ---------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------

# Application environment: dev (default), test or prod. It selects the
# Monolog log file (logs/<env>.log) and controls error details, which
# are shown in dev/test but hidden in prod.
APP_ENV=dev

# Enable HTTP response caching. Disabled by default; see the README section
# "HTTP Response Caching" for details on how it works.
# APP_HTTP_CACHE=1

# Enable request rate limiting per client IP (or per user id when the request
# carries one). Disabled by default; see the README section "Rate Limiting"
# for details. The following variables tune the defaults (60 requests per
# 60 seconds window).
# APP_RATE_LIMIT=1
# APP_RATE_LIMIT_MAX=60
# APP_RATE_LIMIT_WINDOW=60

# ---------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------

# Database driver: pdo_sqlite, pdo_mysql or pdo_pgsql
APP_DB_DRIVER=pdo_sqlite

# Charset used by the database connection
APP_DB_CHARSET=utf8

# --- SQLite (used when APP_DB_DRIVER=pdo_sqlite) ---

# Path to the SQLite database file
APP_DB_PATH=var/data.db

# --- MySQL / PostgreSQL (used when APP_DB_DRIVER=pdo_mysql or pdo_pgsql) ---

# Database host (use "mysql" or "postgres" when running with docker compose)
APP_DB_HOST=127.0.0.1

# Database port (MySQL: 3306, PostgreSQL: 5432)
APP_DB_PORT=3306

# Database name
APP_DB_NAME=slim_app

# Database user
APP_DB_USER=slim_app

# Database password
APP_DB_PASSWORD=

# Port where the application is exposed on the host (docker compose)
APP_PORT=8080
